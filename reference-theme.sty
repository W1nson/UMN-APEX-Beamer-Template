\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reference-theme}[2026/10/14 UMN APEX Beamer style]
\RequirePackage{tikz}
\usetheme{Warsaw}
\definecolor{UMNMaroon}{HTML}{7A0019}
\definecolor{UMNGold}{HTML}{FFCC33}
\setbeamercolor{structure}{fg=UMNMaroon}
\setbeamercolor{title}{fg=UMNGold,bg=UMNMaroon}
\setbeamercolor{frametitle}{fg=UMNMaroon,bg=UMNGold}
\setbeamercolor{frametitle right}{fg=UMNMaroon,bg=UMNGold}
\setbeamercolor{section in head/foot}{fg=white,bg=UMNMaroon}
\setbeamercolor{subsection in head/foot}{fg=white,bg=UMNMaroon}
\setbeamercolor{block title}{fg=UMNGold,bg=UMNMaroon!75!black}
\setbeamercolor{block body}{fg=black,bg=UMNMaroon!8!white}
\setbeamercolor{alerted text}{fg=UMNMaroon}
\setbeamersize{text margin left=0.85cm,text margin right=0.85cm}
\setbeamertemplate{footline}{}
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1.5ex]{section in head/foot}%
    \insertsectionnavigationhorizontal{\paperwidth}{}{}%
  \end{beamercolorbox}%
}
\setbeamerfont{title}{size=\LARGE}
\setbeamertemplate{title page}{%
  \vbox{}\vfill
  \begin{centering}
    \includegraphics[width=.72\textwidth]{assets/logoumn.png}\par
    \vskip1.4em
    \begin{beamercolorbox}[sep=8pt,center,rounded=true,shadow=true]{title}
      \usebeamerfont{title}\inserttitle\par
    \end{beamercolorbox}
    \vskip1em
    {\usebeamerfont{author}\insertauthor\par}
    \vskip.6em
    {\usebeamerfont{institute}\insertinstitute\par}
    \vskip.6em
    {\usebeamerfont{date}\insertdate\par}
    \vskip.8em
    \includegraphics[height=2cm]{assets/apex_icon.jpg}\par
  \end{centering}
  \vfill
}
